# Dockerfile
FROM oven/bun:1.4.0-slim

WORKDIR /app
RUN groupadd --system antx && useradd --system --gid antx --home-dir /app antx

COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production

COPY main.ts openapi.yaml ./
COPY .config ./.config
COPY docs ./docs
COPY src ./src

RUN mkdir -p /app/data && chown -R antx:antx /app/data /app/.config

ENV NODE_ENV=production
ENV PORT=7180
USER antx
EXPOSE 7180
VOLUME [ "/app/data" ]
CMD ["bun", "--no-env-file", "main.ts", "--demo"]
