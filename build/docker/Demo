# Dockerfile
# Build from the repository root: docker build -f build/docker/Demo -t antbox-demo .

# Stage 1: install production dependencies and prepare the writable directories. This stage has a
# shell, the final one does not.
FROM oven/bun:1.4.0-slim AS build

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
RUN bun install --frozen-lockfile --production

COPY main.ts openapi.yaml ./
COPY .config ./.config
COPY docs ./docs
COPY src ./src

RUN mkdir -p /app/data /app/.config/demo && chown -R 65532:65532 /app/data /app/.config

# Stage 2: Bun on a distroless base. No shell, no package manager, no coreutils.
FROM oven/bun:1.4.0-distroless

WORKDIR /app

COPY --from=build --chown=65532:65532 /app /app

ENV NODE_ENV=production
ENV PORT=7180
ENV HOME=/tmp
USER 65532:65532
EXPOSE 7180
VOLUME [ "/app/data", "/app/.config/demo" ]
ENTRYPOINT ["/usr/local/bin/bun", "--no-env-file", "main.ts"]
CMD ["--demo", "--data-dir", "/app"]
