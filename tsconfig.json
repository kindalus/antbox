{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"adapters/*": ["./src/adapters/*"],
			"api/*": ["./src/api/*"],
			"application/*": ["./src/application/*"],
			"domain/*": ["./src/domain/*"],
			"setup/*": ["./src/setup/*"],
			"shared/*": ["./src/shared/*"],
			"integration/*": ["./src/integration/*"],
			"bdd": ["./src/shared/testing/bdd.ts"],
			"expect": ["./src/shared/testing/expect.ts"]
		}
	},
	"include": ["src", "tools", "main.ts", "main_test.ts", "docs/index.ts"]
}
