# Dockerfile
FROM denoland/deno:debian-2.7.14

WORKDIR /app
RUN groupadd --system antx && useradd --system --gid antx --create-home antx
COPY --chown=antx:antx . .

ENV DENO_DIR=/app/.deno
RUN mkdir -p "$DENO_DIR" && chown antx:antx /app "$DENO_DIR"
USER antx

RUN deno cache --frozen \
	--allow-scripts=npm:@google/genai@1.52.0,npm:protobufjs@7.6.5 \
	main.ts

ENV PORT=7180
EXPOSE 7180

CMD ["./start_server.sh", "--sandbox"]
